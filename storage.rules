rules_version = '2';
// Deploy: npm run deploy:rules
// backups/*.json ≤ 4 MB; photos image/* ≤ 5 MB; paths legado users/{uid}/** image-only.
service firebase.storage {
  match /b/{bucket}/o {
    // Fotos do motorista (legado / futuro)
    match /users/{userId}/photos/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    // Backup JSON automático / manual (≤ 4 MB)
    match /users/{userId}/backups/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('application/json');
    }
    // Compat: paths antigos image-only sob users/{uid}/**
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
