{
  // B4 (etapa 1): tipos via JSDoc + checkJs sem mudar o build (esbuild ignora comentários).
  // Começa cobrindo lib/ — onde o contrato de dados vive — e os módulos já
  // extraídos de src/js/. O monolito src/js/main.js entra por último, à medida
  // que cada seção ganhar @typedefs (ver docs/AUDITORIA-TECNICA.md B4).
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    // TypeScript 7 removeu `node` (node10); `bundler` é o equivalente para
    // resolução de import com extensão omitida, igual ao esbuild.
    "moduleResolution": "bundler",
    "checkJs": true,
    // node_modules JS (events/punycode, herdado de @types/node) não é nosso código.
    "skipLibCheck": true,
    // Sem isso o TS7 não carrega os globais do Node (__dirname, node:test…),
    // e os arquivos de teste viram uma cascata de TS2591. O app só usa
    // google.maps em comentários, então não precisa de outros @types.
    "types": ["node"],
    // stubs locais para não type-checar JS de terceiros (events/punycode)
    "paths": {
      "events": ["./types/stubs.d.ts"],
      "punycode": ["./types/stubs.d.ts"]
    },
    "strict": false,
    "noEmit": true
  },
  "include": [
    "types/**/*.d.ts",
    "lib/**/*.js",
    "src/js/photo-store.js",
    "src/js/backup-store.js",
    "src/js/firebase-loader.js",
    "src/js/gallery.js",
    "src/js/track-shared.js",
    "src/js/tracking.js",
    "src/js/history.js",
    "src/js/backup-ui.js",
    "test/*.test.js"
  ],
  "exclude": ["node_modules", "build", "www", "dist", "functions/node_modules"]
}
